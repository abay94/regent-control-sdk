{
  "name": "@regent-protocol/control-sdk",
  "version": "0.2.2",
  "description": "TypeScript SDK for Regent Control \u2014 the runtime enforcement gate for AI agents",
  "keywords": [
    "regent",
    "ai-agents",
    "authorization",
    "policy",
    "enforcement"
  ],
  "license": "Apache-2.0",
  "homepage": "https://docs.regentprotocol.org/control/integration",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abay94/regent-control-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/abay94/regent-control-sdk/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "bin": {
    "regent-control": "./dist/cli.js"
  }
}
